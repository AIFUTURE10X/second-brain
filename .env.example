# ── Database ────────────────────────────────────────────────────────────────
# Neon Postgres connection string
DATABASE_URL=postgresql://username:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ── Auth (required — the app fails closed without these) ───────────────────
# Run `node scripts/generate-auth-env.mjs "your long random passphrase"`
# to generate both values below.
# AUTH_SECRET signs the login session cookie (32+ random bytes, base64).
AUTH_SECRET=
# SHA-256 hex of your login passphrase. Use a long random string, not a word.
AUTH_PASSPHRASE_HASH=
# Token for non-browser clients (extension, scripts): send as
# `Authorization: Bearer <API_SECRET>`. Use a long random value.
API_SECRET=

# ── Cron (required for /api/cron/* — Vercel sends it automatically) ────────
CRON_SECRET=

# ── AI ──────────────────────────────────────────────────────────────────────
# Auto-tagging on save (optional — tagging is skipped without it)
ANTHROPIC_API_KEY=
# AI summaries (optional)
OPENAI_API_KEY=
OPENAI_SUMMARY_MODEL=gpt-5.4-mini

# ── Vercel Blob attachments ─────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ── Telegram bot (optional) ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to talk to the bot
TELEGRAM_ALLOWED_USER_ID=
# Required if the bot is enabled. Register the webhook with this secret:
# https://api.telegram.org/bot<TOKEN>/setWebhook?url=<APP>/api/telegram&secret_token=<VALUE>
TELEGRAM_WEBHOOK_SECRET=
