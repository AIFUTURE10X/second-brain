# ── Required ────────────────────────────────────────────────────────────────

# Neon Postgres connection string (Vercel → Storage → Neon, or neon.tech dashboard)
DATABASE_URL=postgresql://username:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Bearer token for API clients (browser extension, scripts). Generate with:
#   openssl rand -hex 24
# NOTE: there is currently no login on the web UI — see "Security model" in README.
API_SECRET=

# ── AI features (optional — features degrade gracefully when unset) ─────────

# Claude auto-tagging + auto-categorization on save
ANTHROPIC_API_KEY=

# Card summaries ("Summarize" button)
OPENAI_API_KEY=
OPENAI_SUMMARY_MODEL=gpt-5.4-mini

# ── Attachments (optional) ───────────────────────────────────────────────────

# Vercel Blob read-write token (Vercel → Storage → Blob)
BLOB_READ_WRITE_TOKEN=

# ── Telegram bot + crons (optional) ──────────────────────────────────────────

TELEGRAM_BOT_TOKEN=
# Only this Telegram user ID may talk to the bot
TELEGRAM_ALLOWED_USER_ID=
# Set the same value when registering the webhook (&secret_token=...)
TELEGRAM_WEBHOOK_SECRET=
# Bearer token Vercel Cron sends to /api/cron/* (set the same value in Vercel)
CRON_SECRET=
# IANA timezone used to render reminder times in Telegram messages
REMINDER_TIME_ZONE=Asia/Bangkok
# Public base URL used in Telegram card links
NEXT_PUBLIC_APP_URL=https://your-deployment.vercel.app

# ── YouTube transcript enrichment (optional) ─────────────────────────────────

APIFY_API_TOKEN=
APIFY_YOUTUBE_TRANSCRIPT_ACTOR=
