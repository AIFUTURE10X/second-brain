{
  "$schema": "../gen/schemas/windows-schema.json",
  "identifier": "default",
  "description": "Default capability for main window and all pop-out windows",
  "windows": ["*"],
  "remote": {
    "urls": ["https://second-brain-bice-two.vercel.app/*"]
  },
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-open-url",
    "notification:default"
  ]
}
