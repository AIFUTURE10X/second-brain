{
  "$schema": "../gen/schemas/windows-schema.json",
  "identifier": "default",
  "description": "Default capability for main window and pop-out card windows",
  "windows": ["main", "card-*"],
  "remote": {
    "urls": ["https://second-brain-bice-two.vercel.app/*"]
  },
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-open-url"
  ]
}
