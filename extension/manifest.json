{
  "manifest_version": 3,
  "name": "Second Brain — Save to Brain",
  "version": "1.1.2",
  "description": "One-click save any page or selected text to your Second Brain",
  "icons": {
    "16": "icons/brain-16.png",
    "32": "icons/brain-32.png",
    "48": "icons/brain-48.png",
    "128": "icons/brain-128.png"
  },
  "permissions": ["activeTab", "storage", "scripting", "contextMenus"],
  "host_permissions": ["https://*.vercel.app/*"],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "save-page": {
      "suggested_key": { "default": "Ctrl+Shift+S", "mac": "Command+Shift+S" },
      "description": "Save the current page to Brain"
    },
    "annotate-selection": {
      "suggested_key": { "default": "Ctrl+Shift+L", "mac": "Command+Shift+L" },
      "description": "Save the highlighted text as an annotation on this page's card"
    }
  },
  "action": {
    "default_icon": {
      "16": "icons/brain-16.png",
      "32": "icons/brain-32.png",
      "48": "icons/brain-48.png",
      "128": "icons/brain-128.png"
    },
    "default_popup": "popup.html"
  }
}
